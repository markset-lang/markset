{
  "name": "markset",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "markset",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.18"
      }
    },
    "node_modules/@markset/conformance": {
      "resolved": "packages/conformance",
      "link": true
    },
    "node_modules/@markset/parser": {
      "resolved": "packages/parser",
      "link": true
    },
    "packages/conformance": {
      "name": "@markset/conformance",
      "version": "0.0.0",
      "dependencies": {
        "@markset/parser": "*"
      },
      "bin": {
        "markset-conformance": "src/cli.ts"
      }
    },
    "packages/parser": {
      "name": "@markset/parser",
      "version": "0.0.0"
    }
  }
}
