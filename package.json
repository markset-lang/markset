{
  "name": "markset",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf packages/*/dist && node --conditions=markset-source packages/conformance-suite/stage.ts && tsc -p packages/parser/tsconfig.build.json && tsc -p packages/diagram-ascii/tsconfig.build.json && tsc -p packages/render-downgrade/tsconfig.build.json && tsc -p packages/render-html/tsconfig.build.json && tsc -p packages/cli/tsconfig.build.json && tsc -p packages/remark-markset/tsconfig.build.json && tsc -p packages/conformance-suite/tsconfig.build.json",
    "release": "npm run build && npm publish --workspace @markset-lang/parser --workspace @markset-lang/diagram-ascii --workspace @markset-lang/render-downgrade --workspace @markset-lang/render-html --workspace @markset-lang/cli --workspace @markset-lang/remark-markset --workspace @markset-lang/conformance-suite",
    "markset": "node --conditions=markset-source packages/cli/src/markset.ts",
    "test": "node --conditions=markset-source --test packages/*/test/*.test.ts site/test/*.test.ts test/*.test.ts",
    "conformance": "node --conditions=markset-source packages/conformance/src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "site": "node --conditions=markset-source site/build.ts",
    "site:watch": "node --conditions=markset-source site/serve.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^26.5.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markset-lang/markset.git"
  },
  "homepage": "https://markset-lang.github.io/markset/"
}
