{
  "name": "@markset/render-html",
  "version": "0.2.0",
  "description": "HTML renderer: Markset AST -> HTML with the ms- class vocabulary (spec \u00a74).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markset-lang/markset.git",
    "directory": "packages/render-html"
  },
  "homepage": "https://markset-lang.github.io/markset/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "markdown",
    "html",
    "markset",
    "renderer",
    "hast"
  ],
  "files": [
    "dist",
    "src",
    "css"
  ],
  "exports": {
    ".": {
      "markset-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/markset.css": "./css/markset.css"
  },
  "dependencies": {
    "@markset/parser": "^0.2.0",
    "@markset/diagram-ascii": "^0.2.0",
    "mdast-util-to-hast": "^13.2.0",
    "hast-util-to-html": "^9.0.5"
  }
}
