{
  "name": "@markset-lang/cli",
  "version": "0.4.0",
  "description": "markset command line: check, html, downgrade, ast, and the authoring guide for agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markset-lang/markset.git",
    "directory": "packages/cli"
  },
  "homepage": "https://markset.org/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "markdown",
    "markset",
    "cli"
  ],
  "files": [
    "dist",
    "src",
    "guide.md"
  ],
  "exports": {
    ".": {
      "markset-source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "bin": {
    "markset": "dist/markset.js"
  },
  "dependencies": {
    "@markset-lang/parser": "^0.4.0",
    "@markset-lang/render-downgrade": "^0.4.0",
    "@markset-lang/render-html": "^0.4.0",
    "@markset-lang/diagram-ascii": "^0.4.0"
  }
}
