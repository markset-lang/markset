{
  "name": "@markset/parser",
  "version": "0.2.0",
  "description": "Markset parser: CommonMark base plus the Markset grammar extensions, producing an AST.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markset-lang/markset.git",
    "directory": "packages/parser"
  },
  "homepage": "https://markset-lang.github.io/markset/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "markset",
    "mdast",
    "parser"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "markset-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark": "^4.0.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-symbol": "^2.0.1"
  }
}
